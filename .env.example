# ==================================================
# Smart NGO Platform - Environment Variables Template
# Copy this file to .env and fill in real production values.
# NEVER commit real credentials or .env files to GitHub!
# ==================================================

# Spring Active Profile (dev | test | prod)
SPRING_PROFILES_ACTIVE=prod

# Server Port (assigned by Cloud Platform or default 8080)
PORT=8080

# Production Database Credentials (Cloud MySQL Server)
DB_HOST=your-cloud-mysql-host.provider.com
DB_PORT=3306
DB_NAME=smart_ngo
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Initial Administrator Credentials (used on first production launch)
ADMIN_EMAIL=admin@smartngo.com
ADMIN_PASSWORD=change_this_secure_admin_password_123

# External Payment API Credentials
PAYMENT_MODE=mock
PAYMENT_KEY=rzp_live_your_key_here
PAYMENT_SECRET=your_razorpay_secret_here

# Notification API Credentials
NOTIFICATION_MODE=mock
EMAIL_API_KEY=your_sendgrid_or_mailgun_key
SMS_API_KEY=your_twilio_key

# Security & Public URL
SECURITY_SECRET=your_jwt_or_session_secret_key
APP_BASE_URL=https://smartngo.yourdomain.com
